ALFRED_API_URL=http://alfred-api:8080
# Dedicated scoped API credential: archive.read, plus mail.read, calendar.* and todos.* for those tools; never the legacy API_TOKEN.
ALFRED_API_TOKEN=__REQUIRED__
# Different token, presented by Hermes to this MCP service.
MCP_TOKEN=__REQUIRED__
MCP_ALLOWED_HOSTS=alfred-mcp,localhost,127.0.0.1,[::1]
HTTP_PORT=8080
MCP_RATE_LIMIT=60
MCP_MAX_CONCURRENT=4
