{
  "name": "@alfred/api",
  "version": "0.4.0",
  "private": true,
  "description": "HTTP API over the archive and the notes",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
