{
  "name": "wa-ingest",
  "version": "0.1.0",
  "private": true,
  "description": "Archives a WhatsApp account (linked device) into Postgres",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.1",
    "baileys": "7.0.0-rc14",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/qrcode-terminal": "0.12.2",
    "typescript": "7.0.2"
  }
}
